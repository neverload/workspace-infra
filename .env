# MongoDB：默认端口 27017，无认证，mongodb://127.0.0.1:27017
#
# Caddy → 宿主机上的 Next / FastAPI（须与各仓库 web、server 启动端口一致）
NEXTGIRL_WEB_PORT=3000
NEXTGIRL_API_PORT=8000
NEXTGIRL_WS_PORT=8010
INTELINK_WEB_PORT=3200
INTELINK_SERVER_PORT=8200
FUTURIST_WEB_PORT=3100
FUTURIST_SERVER_PORT=8100

# dev/prod 使用 compose 里 network_mode:host 时走宿主机网络栈，一般不必再配 CLASH_*；若改回 bridge 容器再取消下行注释。
# CLASH_HTTP_PROXY=http://host.docker.internal:7890
# CLASH_HTTPS_PROXY=http://host.docker.internal:7890
# CLASH_ALL_PROXY=socks5://host.docker.internal:7891
# CLASH_NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal
